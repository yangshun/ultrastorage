{
  "name": "ultrastorage",
  "version": "0.10.0",
  "description": "Gives localStorage superpowers. Handles serialization of rich types, key expiration, namespacing, and schema validation",
  "keywords": [
    "expiration",
    "localstorage",
    "serialization",
    "storage",
    "ttl"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core-entry.d.mts",
        "default": "./dist/core-entry.mjs"
      },
      "require": {
        "types": "./dist/core-entry.d.cts",
        "default": "./dist/core-entry.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "scripts": {
    "check": "vp check",
    "build": "vp pack",
    "prepublishOnly": "vp check && vp test run && vp pack && node scripts/verify-package.mjs",
    "format": "vp fmt",
    "lint": "vp lint",
    "tc": "vp check",
    "test": "vp test run",
    "test:package": "vp pack && node scripts/verify-package.mjs",
    "test:watch": "vp test",
    "prepare": "vp config",
    "test:coverage": "vp test run --coverage",
    "docs:dev": "cd docs && blume dev",
    "docs:build": "cd docs && blume build",
    "docs:preview": "cd docs && blume preview",
    "docs:validate": "cd docs && blume validate --strict"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "devalue": "^6.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "blume": "^2.2.4",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.3"
}
