{
  "name": "greatstorage",
  "version": "0.5.0",
  "description": "Gives localStorage superpowers. Handles serialization of rich types, key expiration, namespacing, and schema validation",
  "keywords": [
    "expiration",
    "localstorage",
    "serialization",
    "storage",
    "ttl"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core-entry.d.mts",
        "default": "./dist/core-entry.mjs"
      },
      "require": {
        "types": "./dist/core-entry.d.cts",
        "default": "./dist/core-entry.cjs"
      }
    }
  },
  "scripts": {
    "check": "vp check",
    "build": "vp pack",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "format": "vp fmt",
    "lint": "vp lint",
    "tc": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "vp config"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "devalue": "^5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
